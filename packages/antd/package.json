{
  "name": "@brt-innovation/antd",
  "version": "0.0.0",
  "description": "BRT design tokens + components สำหรับ Ant Design v6",
  "keywords": [
    "brt",
    "design-system",
    "antd",
    "ant-design",
    "react",
    "theme"
  ],
  "license": "UNLICENSED",
  "author": "BRT Innovation",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brtinnovation/brt-design-system.git",
    "directory": "packages/antd"
  },
  "homepage": "https://github.com/brtinnovation/brt-design-system/tree/main/packages/antd#readme",
  "bugs": {
    "url": "https://github.com/brtinnovation/brt-design-system/issues"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./tokens": {
      "import": {
        "types": "./dist/tokens.d.ts",
        "default": "./dist/tokens.js"
      },
      "require": {
        "types": "./dist/tokens.d.cts",
        "default": "./dist/tokens.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "dependencies": {
    "@brt-innovation/design": "workspace:^"
  },
  "peerDependencies": {
    "antd": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "antd": "^6.6.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
