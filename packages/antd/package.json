    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@brt/design": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "antd": "^6.6.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
