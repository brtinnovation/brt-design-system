{
  "name": "@brt-innovation/design",
  "version": "0.0.0",
  "description": "BRT design tokens จาก Figma — primitive, semantic, defineBrand และ CSS variables (ไม่ผูกกับ framework)",
  "keywords": [
    "brt",
    "design-tokens",
    "design-system",
    "css-variables",
    "figma"
  ],
  "license": "UNLICENSED",
  "author": "BRT Innovation",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brtinnovation/brt-design-system.git",
    "directory": "packages/design"
  },
  "homepage": "https://github.com/brtinnovation/brt-design-system/tree/main/packages/design#readme",
  "bugs": {
    "url": "https://github.com/brtinnovation/brt-design-system/issues"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./tokens.css": "./dist/tokens.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup && tsx scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build && pnpm run test"
  }
}
